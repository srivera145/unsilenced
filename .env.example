APP_NAME="Unsilenced"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://unsilenced.local
# Shown on /corrections as the address for reporting an error. Required in production.
CORRECTIONS_EMAIL=
# true ONLY behind a proxy or CDN that ends HTTPS and forwards plain HTTP with
# X-Forwarded-Proto (a load balancer, Cloudflare Flexible). It decides HSTS and
# the admin cookie's Secure flag. Never true when visitors can reach PHP directly.
TRUST_PROXY=false
# Survivor reports and the evidence vault (docs/SURVIVOR-REPORTS.md). Leave
# SUBMISSIONS_ENABLED=false until legal review: /submit, /my-report and /share
# then show a "coming soon" page; the admin queue still works for testing.
SUBMISSIONS_ENABLED=false
# 32 random bytes, base64. Generate with: php database/console.php vault:keygen
# It encrypts every evidence file and every account. Lose it and they are
# unreadable; leak it and they are readable. Never in git, never in a backup.
VAULT_MASTER_KEY=
# Where encrypted evidence files live. Must be outside public_html. Default:
# storage/vault
VAULT_PATH=
# Only after a key rotation (php database/console.php vault:rotate): the line
# it prints, which keeps existing case keys working. Leave unset until then.
# VAULT_LOOKUP_KEY=
# Only during a rotation: the new key, then moved into VAULT_MASTER_KEY.
# VAULT_NEW_MASTER_KEY=
APP_REPO_URL=
APP_LICENSE=TODO

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=unsilenced
DB_USERNAME=root
DB_PASSWORD=

# otp | magic_link | both
AUTH_METHOD=both

# Mail configuration
# smtp | log
# - smtp (default): real email delivery via configured SMTP provider.
# - log: write outgoing mail to storage/logs/mail.log (useful for local dev before SMTP is set up).
#   In log mode, request an OTP or magic link and read the code/URL from that file.
MAIL_MAILER=smtp

MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=admin@unsilencednow.org
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Unsilenced"
