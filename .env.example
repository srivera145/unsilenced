APP_NAME="Unsilenced"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://unsilenced.local
APP_REPO_URL=
APP_LICENSE=TODO

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=unsilenced
DB_USERNAME=root
DB_PASSWORD=

# otp | magic_link | both
AUTH_METHOD=both

# Mail configuration
# smtp | log
# - smtp (default): real email delivery via configured SMTP provider.
# - log: write outgoing mail to storage/logs/mail.log (useful for local dev before SMTP is set up).
#   In log mode, request an OTP or magic link and read the code/URL from that file.
MAIL_MAILER=smtp

MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Unsilenced"
